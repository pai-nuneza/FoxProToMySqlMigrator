<Window x:Class="FoxProToMySqlMigrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoxPro to MySQL Migrator"
        Height="720"
        Width="1180"
        MinHeight="600"
        MinWidth="980"
        Background="#121212"
        Foreground="#E7E7E7"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121212"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A7A7A7"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1DB954"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1ED760"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
        <SolidColorBrush x:Key="InputBrush" Color="#242424"/>

        <Storyboard x:Key="SpinnerAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1"/>
        </Storyboard>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="TipTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7E7E7E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="5"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Background="Transparent"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinHeight="34">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#222222"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#16251B"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#244F32"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
                    <Setter Property="Background" Value="#16251B"/>
                    <Setter Property="BorderBrush" Value="#244F32"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#07130B"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#101010"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#263A2D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FoxPro to MySQL Migrator"
                               FontSize="23"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="TxtAppVersion"
                               Text="v0.0.0.0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="10,8,0,0"/>
                </StackPanel>
                <TextBlock Text="Move DBF tables into MySQL with checkpoints, repair logs, and table-level status."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="13"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#16251B"
                    BorderBrush="#244F32"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatusBadge"
                               Text="Ready"
                               Foreground="{StaticResource AccentHoverBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="CheckpointNotification"
                Grid.Row="1"
                Background="#2C2414"
                BorderBrush="#7A5A17"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,10"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="!"
                           Foreground="#FFC857"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtCheckpointMessage"
                           Grid.Column="1"
                           Foreground="#F7E3AA"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnResumeCheckpoint"
                        Grid.Column="2"
                        Content="Resume Migration"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="12,0,0,0"
                        Click="BtnResumeCheckpoint_Click"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Migration">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5">
                        <TextBlock Text="FoxPro folder" Style="{StaticResource LabelTextStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtFoxProFolder"
                                     Grid.Column="0"
                                     TextChanged="TxtFoxProFolder_TextChanged"
                                     ToolTip="Folder containing the .dbf files."/>
                            <Button Grid.Column="2"
                                    Content="Browse"
                                    Style="{StaticResource AppButtonStyle}"
                                    Click="BrowseFolder_Click"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,8,0,0">
                        <TextBlock Text="Batch size" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox x:Name="TxtBatchSize"
                                     Text="1000"
                                     TextChanged="TxtSettings_TextChanged"
                                     ToolTip="Number of records to commit per batch (recommended: 500-2000)"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                        <TextBlock Text="MySQL server" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox x:Name="TxtMySqlServer"
                                 TextChanged="TxtSettings_TextChanged"
                                 ToolTip="Connection string without the database name. Example: Server=localhost;User Id=root;Password=yourpass;"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                        <TextBlock Text="Target database" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox x:Name="TxtDatabaseName"
                                 TextChanged="TxtDatabaseName_TextChanged"
                                 ToolTip="The MySQL database to create or update."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnMigrate"
                            Grid.Column="0"
                            Content="Migrate"
                            MinWidth="98"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnMigrate_Click"/>
                    <Button x:Name="BtnUpdateTypes"
                            Grid.Column="1"
                            Content="Update Data Types"
                            MinWidth="132"
                            Margin="8,0,0,0"
                            Style="{StaticResource AppButtonStyle}"
                            Click="BtnUpdateTypes_Click"/>
                    <Button x:Name="BtnStop"
                            Grid.Column="2"
                            Content="Stop"
                            MinWidth="86"
                            Margin="8,0,0,0"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BtnStop_Click"
                            Visibility="Collapsed"/>
                    <Button x:Name="BtnClearLog"
                            Grid.Column="3"
                            Content="Clear Logs"
                            MinWidth="96"
                            Margin="8,0,0,0"
                            Style="{StaticResource AppButtonStyle}"
                            Click="BtnClearLog_Click"/>

                    <StackPanel x:Name="LoadingSpinner"
                                Grid.Column="4"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{StaticResource AccentBrush}"
                                      Data="M12,4 A8,8 0 0,1 20,12">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotation" CenterX="12" CenterY="12"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="LoadingText"
                                   Text="Migrating..."
                                   Foreground="{StaticResource AccentHoverBrush}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnDeleteHistory"
                            Grid.Column="5"
                            Content="Delete Logs &amp; History"
                            MinWidth="156"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BtnDeleteHistory_Click"/>
                    <Button x:Name="BtnOpenLogsFolder"
                            Grid.Column="6"
                            Content="Open Data Folder"
                            MinWidth="130"
                            Margin="8,0,0,0"
                            Style="{StaticResource AppButtonStyle}"
                            Click="BtnOpenLogsFolder_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Migration Log"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <CheckBox Grid.Column="1"
                                      x:Name="ChkFollowLog"
                                      Content="Follow log"
                                      IsChecked="False"
                                      Margin="12,0,0,10"
                                      VerticalAlignment="Top"/>
                        </Grid>
                        <ListBox Grid.Row="1"
                                 x:Name="LstLog"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{StaticResource AppBackgroundBrush}"/>

                <Border Grid.Column="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Table Summary"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <ListBox Grid.Row="1"
                                 x:Name="LstTableSummary"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
                </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Table Inventory">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Migration table filter"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <CheckBox x:Name="ChkOnlySelectedTables"
                                          Content="Use this filter"
                                          IsChecked="False"
                                          FontSize="13"
                                          FontWeight="Bold"
                                          Foreground="#FF5C5C"
                                          ToolTip="When checked, only DBF tables listed in needed-tables.json are migrated."
                                          Checked="TableFilterSettings_Changed"
                                          Unchecked="TableFilterSettings_Changed"/>
                                <TextBlock x:Name="TxtSelectedTableCount"
                                           Text="Allowlist OFF - all DBF tables will be migrated"
                                           Foreground="#FF7A7A"
                                           FontSize="11"
                                           Margin="22,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="14,0,0,0">
                                <Button Content="Reload JSON"
                                        Style="{StaticResource AppButtonStyle}"
                                        MinWidth="112"
                                        Click="BtnReloadNeededTables_Click"/>
                                <Button Content="Open JSON"
                                        Style="{StaticResource AppButtonStyle}"
                                        MinWidth="104"
                                        Margin="8,0,0,0"
                                        Click="BtnOpenNeededTablesJson_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Read-only list loaded from the same saved settings folder as the connection string."
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,8"/>
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="LstNeededTables">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#101010"
                                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8,6"
                                                    Margin="0,0,8,8">
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
